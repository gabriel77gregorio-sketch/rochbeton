---
// ContactSection.astro - Localização da Fábrica & Showroom, Telefones e Horários
---

<section id="contato" class="py-24 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Cabeçalho -->
    <div class="max-w-3xl mx-auto text-center mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#B85D43]/10 text-[#B85D43] text-xs font-semibold tracking-wider uppercase">
        <span>Showroom & Fábrica Própria</span>
      </div>
      <h2 class="font-editorial text-3xl sm:text-5xl font-semibold text-[#1C1D1F] tracking-tight">
        Venha conhecer de perto a nossa produção.
      </h2>
      <p class="text-stone-600 text-base sm:text-lg">
        Localizada na Grande São Paulo com fácil acesso pelo Rodoanel e Rodovia Régis Bittencourt. Atendimento a arquitetos, construtores e proprietários.
      </p>
    </div>

    <!-- Grid: Informações Reais + Mapa Interativo -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Coluna da Esquerda: Dados de Contato e Horários (5 colunas) -->
      <div class="lg:col-span-5 flex flex-col justify-between p-8 rounded-3xl bg-[#F9F8F6] border border-stone-200/80 shadow-sm space-y-8">
        
        <!-- Endereço -->
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-[#B85D43]/10 text-[#B85D43] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-stone-400">Endereço da Fábrica</span>
              <h3 class="text-sm font-bold text-[#1C1D1F]">Rua Guairá, 36 – Jardim Salete</h3>
              <p class="text-xs text-stone-600">Taboão da Serra – SP | CEP: 06793-010</p>
            </div>
          </div>
          
          <a
            href="https://maps.google.com/?q=Rua+Guair%C3%A1,+36+-+Jardim+Salete,+Tabo%C3%A3o+da+Serra+-+SP,+06793-010"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#B85D43] hover:underline"
          >
            <span>Como chegar no Google Maps ↗</span>
          </a>
        </div>

        <!-- Horários de Funcionamento Reais -->
        <div class="space-y-3 pt-4 border-t border-stone-200">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-[#C49746]/15 text-[#C49746] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-stone-400">Horários de Atendimento</span>
              <div class="space-y-0.5 text-xs text-stone-700 mt-1">
                <div><strong class="text-stone-900">Segunda a Quinta:</strong> 08h00 às 16h45</div>
                <div><strong class="text-stone-900">Sexta-feira:</strong> 08h00 às 16h00</div>
                <div><strong class="text-stone-900">Sábado:</strong> 08h00 às 12h00</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Telefones e Canais Digitais -->
        <div class="space-y-3 pt-4 border-t border-stone-200">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-[#2C4258]/10 text-[#2C4258] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div class="space-y-1">
              <span class="text-xs font-bold uppercase tracking-wider text-stone-400">Telefones & WhatsApp</span>
              <div class="text-xs text-stone-800 space-y-1">
                <div>Fixo: <a href="tel:1141381015" class="font-bold hover:text-[#B85D43]">(11) 4138-1015</a></div>
                <div>WhatsApp 1: <a href="https://wa.me/5511991008594" class="font-bold text-emerald-700 hover:underline">(11) 99100-8594</a></div>
                <div>WhatsApp 2: <a href="https://wa.me/5511947288289" class="font-bold text-emerald-700 hover:underline">(11) 94728-8289</a></div>
              </div>
            </div>
          </div>
        </div>

        <!-- E-mails -->
        <div class="pt-4 border-t border-stone-200 text-xs text-stone-600 space-y-1">
          <div class="font-bold text-stone-700">E-mails Comerciais:</div>
          <div class="flex flex-col gap-0.5">
            <a href="mailto:vendas@rochbeton.com.br" class="hover:text-[#B85D43]">vendas@rochbeton.com.br</a>
            <a href="mailto:rb.ltda@uol.com.br" class="hover:text-[#B85D43]">rb.ltda@uol.com.br</a>
          </div>
        </div>

      </div>

      <!-- Coluna da Direita: Mapa Google e Card de Rápido Contato (7 colunas) -->
      <div class="lg:col-span-7 flex flex-col justify-between rounded-3xl overflow-hidden border border-stone-200/80 shadow-sm bg-stone-100 min-h-[460px] relative">
        <!-- Google Maps Embed Real -->
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3655.856999285098!2d-46.77977462378873!3d-23.60946126335198!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ce5187e59b2075%3A0xe54ef5f9923831ec!2sR.%20Guair%C3%A1%2C%2036%20-%20Jardim%20Salete%2C%20Tabo%C3%A3o%20da%20Serra%20-%20SP%2C%2006793-010!5e0!3m2!1spt-BR!2sbr!4v1711200000000!5m2!1spt-BR!2sbr"
          width="100%"
          height="100%"
          style="border:0; min-height: 380px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full object-cover filter grayscale contrast-125 hover:grayscale-0 transition-all duration-700"
          title="Mapa de Localização Rochbeton"
        ></iframe>

        <!-- Card Flutuante Sobre o Mapa -->
        <div class="absolute bottom-5 left-5 right-5 sm:left-auto sm:right-5 sm:max-w-sm p-5 rounded-2xl bg-white/95 backdrop-blur-md border border-white/80 shadow-xl space-y-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="text-xs font-bold text-emerald-800">Fábrica & Showroom Abertos</span>
          </div>
          <p class="text-xs text-stone-600 leading-snug">
            Estacionamento no local e atendimento personalizado para escolha das peças do seu projeto.
          </p>
          <a
            href="https://wa.me/5511991008594?text=Ol%C3%A1!%20Gostaria%20de%20agendar%20uma%20visita%20ao%20Showroom%20da%20Rochbeton."
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full py-2.5 rounded-xl bg-[#1C1D1F] hover:bg-[#B85D43] text-white text-xs font-semibold text-center transition-colors shadow-xs"
          >
            Agendar Visita ao Showroom
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
