---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloating from '../components/WhatsAppFloating.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Rochbeton | Ladrilhos Hidráulicos Artesanais & Design desde 1985",
  description = "Fabricação artesanal sob medida de ladrilhos hidráulicos em Taboão da Serra/SP desde 1985. Catálogo de decorados, hexagonais, antiderrapantes e podotáteis com cura hidráulica sem queima."
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Favicon com o logo Rochbeton -->
    <link rel="icon" type="image/png" href="/images/logo-rochbeton.png" />
    
    <!-- Open Graph / Meta Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/logo-rochbeton.png" />
    
    <!-- Google Fonts: Playfair Display (Editorial) & Plus Jakarta Sans (Modern Apple Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#F9F8F6] text-[#1C1D1F] selection:bg-[#B85D43] selection:text-white antialiased min-h-screen flex flex-col overflow-x-hidden">
    <!-- Navbar Flutuante Liquid Glass -->
    <Navbar />

    <!-- Conteúdo Principal -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- Rodapé Completo Institucional -->
    <Footer />

    <!-- Botão de WhatsApp Flutuante com Micro-Interações -->
    <WhatsAppFloating />
  </body>
</html>
